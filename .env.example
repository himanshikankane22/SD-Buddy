# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit your API key.

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use for chat answers. Pick any OpenRouter model.
# Cheap + reliable defaults:
#   openrouter/auto                - automatic routing
#   deepseek/deepseek-chat-v3-0324 - strong, low cost
#   qwen/qwen-2.5-72b-instruct     - good general purpose
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Max tokens in LLM responses
OPENROUTER_MAX_TOKENS=600

# Chat temperature
OPENROUTER_TEMPERATURE=0.3

# Backend CORS origins (comma separated) for the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
